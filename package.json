{
  "name": "viz-audio",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  },
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite ./src/demo-app",
    "type-check": "tsc",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "check-exports": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "ci": "npm run lint && npm run type-check && npm run build && npm run format:check && npm run check-exports && npm run test",
    "prepublishOnly": "npm run ci",
    "local-release": "npm run ci && changeset version && changeset publish"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.3",
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.1.25",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.4",
    "vitest-canvas-mock": "^0.3.3"
  },
  "description": "Audio visualizer for audio samples in React",
  "keywords": [
    "audio",
    "react",
    "react-audio",
    "visualizer"
  ],
  "homepage": "https://github.com/or-yam/react-audio-viz",
  "bugs": {
